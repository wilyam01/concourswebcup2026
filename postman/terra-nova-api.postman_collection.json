{
  "info": {
    "_postman_id": "7fb19f06-f20c-4f1e-97f8-64dab32824ca",
    "name": "Terra Nova - API WebCup",
    "description": "Read-only API discovery and request smoke tests. Set apiKey as a local secret variable before the authenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "apiBaseUrl", "value": "https://24h.webcup.fr" },
    { "key": "apiKey", "value": "" },
    { "key": "proxyBaseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "1. Discover official REST routes",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{apiBaseUrl}}/wp-json/" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('REST index responds with 200', () => pm.response.to.have.status(200));",
            "const index = pm.response.json();",
            "pm.test('WebCup namespace is published', () => pm.expect(index.namespaces).to.include('webcup/v1'));",
            "pm.test('Requests route is GET-only', () => pm.expect(index.routes['/webcup/v1/requests'].endpoints[0].methods).to.eql(['GET']));"
          ]
        }
      }]
    },
    {
      "name": "2. Confirm requests require credentials",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{apiBaseUrl}}/wp-json/webcup/v1/requests" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Unauthenticated requests are rejected', () => pm.response.to.have.status(403));",
            "pm.test('Error response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
          ]
        }
      }]
    },
    {
      "name": "3. Read official requests (requires local apiKey)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{apiBaseUrl}}/wp-json/webcup/v1/requests?api_key={{apiKey}}",
          "query": [{ "key": "api_key", "value": "{{apiKey}}" }]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Authenticated requests respond with 200', () => pm.response.to.have.status(200));",
            "const payload = pm.response.json();",
            "const requests = Array.isArray(payload) ? payload : (payload.requests || payload.data || payload.items);",
            "pm.test('Response contains a request collection', () => pm.expect(requests).to.be.an('array'));",
            "requests.forEach((request) => pm.expect(request.id || request.reference || request.request_id).to.exist);"
          ]
        }
      }]
    },
    {
      "name": "4. Read sanitized application proxy",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{proxyBaseUrl}}/api/requests" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Proxy responds with 200', () => pm.response.to.have.status(200));",
            "const payload = pm.response.json();",
            "pm.test('Proxy returns a requests array', () => pm.expect(payload.requests).to.be.an('array'));",
            "const allowed = ['id', 'title', 'district', 'type', 'priority', 'status', 'updatedAt', 'description'];",
            "payload.requests.forEach((request) => Object.keys(request).forEach((key) => pm.expect(allowed).to.include(key)));"
          ]
        }
      }]
    },
    {
      "name": "5. Verify proxy rejects writes",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{proxyBaseUrl}}/api/requests" },
        "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Proxy refuses unsupported writes with 405', () => pm.response.to.have.status(405));",
            "pm.test('Allow header documents GET-only access', () => pm.expect(pm.response.headers.get('Allow')).to.eql('GET'));"
          ]
        }
      }]
    }
  ]
}
