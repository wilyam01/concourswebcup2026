PORT=3000
# Set to the exact proxy hop count in production; keep 0 for direct/local access.
TRUST_PROXY_HOPS=0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
DATABASE_PATH=./data/terra-nova.sqlite
CORS_ORIGIN=http://localhost:5500
# Leave blank to keep the municipal request service in demo mode.
TERRA_NOVA_API_URL=
TERRA_NOVA_API_KEY=
TERRA_NOVA_POLL_MS=30000
# Passwordless sign-in and new-device email alerts (requires a verified sender).
RESEND_API_KEY=
RESEND_FROM=
# Required to enable citizen TOTP 2FA; generate a private 32-byte key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=
